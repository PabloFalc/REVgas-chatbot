{
  "name": "revgas-chatbot",
  "version": "0.0.0",
  "description": "Chatbot de WhatsApp que cria vendas no ERP RevGás via API (Projeto de Extensão 2026.2 — Flow)",
  "author": "Pablo Falc",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "nest build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "docker:init": "docker compose up -d",
    "docker:stop": "docker compose stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --reporter=verbose",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "revgas:check": "vitest run --config vitest.config.live.ts scripts/revgas.live-check.spec.ts",
    "llm:check": "vitest run --config vitest.config.live.ts scripts/llm.live-check.spec.ts"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/under-pressure": "^9.2.1",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@scalar/fastify-api-reference": "^1.75.0",
    "better-auth": "^1.7.11",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "resend": "6.12.4",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "~1.15.40",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "fastify": "^5.12.5",
      "multer": "^2.3.0",
      "path-to-regexp@8": "^8.4.0",
      "js-yaml@5": "^5.4.1"
    }
  }
}
