{
  "name": "revgas-chatbot",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --compile --minify --sourcemap --outfile dist/revgas-chatbot",
    "test": "bun test",
    "test:unit": "bun test --pass-with-no-tests ./src",
    "test:e2e": "bun test --pass-with-no-tests ./tests/e2e",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose up -d --build --force-recreate app",
    "docker:logs": "docker compose logs -f app",
    "docker:ps": "docker compose ps",
    "docker:infra": "docker compose up -d postgres redis",
    "docker:reset": "docker compose down -v"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
