# Variáveis do docker/compose.prod.yaml, lidas pelo render-prod-env (scripts/deploy).
# Cada bloco começa com uma linha de categoria:
#   GERADA: segredo aleatório novo, criado pelo render (variantes: longa, senha)
#   ORIGEM: credencial externa que já existe; vem do arquivo-fonte (opcional: pode ficar vazia)
#   FIXA: valor não secreto, já preenchido aqui

# GERADA
POSTGRES_PASSWORD=
REDIS_PASSWORD=
WHATSAPP_VERIFY_TOKEN=
CHATWOOT_DB_PASSWORD=
CHATWOOT_REDIS_PASSWORD=
CHATWOOT_API_TOKEN=
CHATWOOT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRET=
METABASE_DB_PASSWORD=
METABASE_ENCRYPTION_KEY=
METRICS_READER_PASSWORD=

# GERADA longa
CHATWOOT_SECRET_KEY_BASE=

# GERADA senha
CHATWOOT_ADMIN_PASSWORD=
CHATWOOT_AGENT_PASSWORD=
METABASE_ADMIN_PASSWORD=

# ORIGEM
REVGAS_API_KEY=
REVGAS_ESTABLISHMENT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ALLOWED_SENDERS=
LLM_API_KEY=

# ORIGEM opcional
EMBEDDING_API_KEY=
CHATWOOT_AGENT_EMAILS=
STORE_PHONE=
SERVICE_HOURS=

# FIXA
BOT_IMAGE_TAG=sha-6644ad4
NODE_ENV=production
PUBLIC_BOT_URL=https://revgas.felipeduan.com
CORS_ORIGIN=https://revgas.felipeduan.com
