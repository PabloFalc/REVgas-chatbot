# =============================================================================
# DESENVOLVIMENTO (copie para .env e preencha; nunca commite .env)
# Referencia completa de cada variavel: docs/guides/conventions/environment.md
# =============================================================================

NODE_ENV=development
PORT=3100
HOST=0.0.0.0
# Nivel do logger (opcional): fatal|error|warn|info|debug|trace|silent.
# Sem valor, o default e debug (dev), info (producao), silent (test).
# LOG_LEVEL=debug

# BETTER AUTH (STANDBY - modulo desligado; so precisa quando o auth for religado)
# Login por token Bearer. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# CORS - obrigatorio EM PRODUCAO (e sem "*"). Em dev pode ficar vazio.
CORS_ORIGIN=http://localhost:3000

# PROXY - confianca no X-Forwarded-For. Vazio/false = nao confia (default seguro).
# Atras de proxy/LB informe o IP/CIDR do proxy (ex.: 10.0.0.0/8). Contagem de hops ("1") e recusada no boot. NUNCA "true" exposto direto.
TRUSTED_PROXY=

# PostgreSQL
DATABASE_URL=postgresql://docker:docker@localhost:5432/revgas
# Credenciais do container do docker-compose. Mantenha em sincronia com a DATABASE_URL.
POSTGRES_USER=docker
POSTGRES_PASSWORD=docker
POSTGRES_DB=revgas
# Pool (opcional; defaults abaixo)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000

# Redis (estado da conversa com TTL, rate limit, sessoes do Better Auth)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# UNDER PRESSURE - limites de memoria do circuit breaker (opcional). Calibre ao container.
PRESSURE_MAX_HEAP_BYTES=500000000
PRESSURE_MAX_RSS_BYTES=800000000

# Swagger - protege /openapi.json e /docs (opcional, vazio = sem protecao em dev)
DOC_TOKEN=

# API RevGas - a chave fica SO no servidor (RNF02). Solicitada ao suporte da RevGas.
# REVGAS_MODE: live | hybrid | fake. Vazio = automatico: hybrid se REVGAS_API_KEY estiver definida, senao fake.
REVGAS_MODE=
REVGAS_API_URL=https://api.revgas.com/v1
REVGAS_ESTABLISHMENT_ID=
REVGAS_TIMEOUT_MS=10000
REVGAS_MIN_INTERVAL_MS=1100
REVGAS_API_KEY=

# WhatsApp - Cloud API oficial da Meta. Passo a passo: docs/guides/integrations/whatsapp.md
# WHATSAPP_MODE: live | fake. Vazio = automatico: live se WHATSAPP_ACCESS_TOKEN estiver definido, senao fake
# (fake = nada sai para o WhatsApp; as respostas aparecem no log).
WHATSAPP_MODE=
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v23.0
# Meta for Developers > seu app > WhatsApp > Configuracao da API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Meta for Developers > seu app > Configuracoes do app > Basico > Chave secreta do app (confere a assinatura do webhook)
# Em producao WHATSAPP_APP_SECRET e WHATSAPP_VERIFY_TOKEN sao obrigatorios mesmo em fake.
WHATSAPP_APP_SECRET=
# Texto que voce inventa (min. 16 chars) e repete na tela do webhook da Meta. Gere com: openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TIMEOUT_MS=10000

# LLM (Gemini via API compativel com OpenAI)
# Chave gratuita em aistudio.google.com (plano gratuito). Vazio = automatico: live se houver chave, senao fake.
# live exige LLM_API_KEY. Em fake a IA nao e chamada e o bot fica so com botoes.
LLM_MODE=
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
LLM_TIMEOUT_MS=8000

# VIACEP (consulta de CEP, API publica e gratuita, sem chave)
# Vazio = automatico: live fora de NODE_ENV=test, fake em test.
VIACEP_MODE=
VIACEP_API_URL=https://viacep.com.br/ws
VIACEP_TIMEOUT_MS=5000

# LOJA (cidade e UF assumidas quando o cliente nao informa no endereco)
STORE_CITY=Teresina
STORE_STATE=PI
# Telefone da revenda mostrado ao cliente ao pedir atendimento (texto livre, opcional)
STORE_PHONE=

# RESEND (STANDBY - usado so pelo Better Auth: verificacao de email e reset de senha)
# Sem chave e sem EMAIL_DEV_REDIRECT, os emails sao apenas logados.
RESEND_API_KEY=
# Sem dominio verificado, use onboarding@resend.dev. Em producao: "Nome <no-reply@seudominio.com>".
EMAIL_FROM=onboarding@resend.dev
# Opcional (dev): redireciona todos os emails para este endereco (email dono da conta Resend).
EMAIL_DEV_REDIRECT=

# =============================================================================
# PRODUCAO (nunca commitar valores reais - use secrets do servidor/CI)
# =============================================================================
# NODE_ENV=production
# BETTER_AUTH_SECRET=...      # so com auth ligado - openssl rand -base64 32
# BETTER_AUTH_URL=https://api.seudominio.com
# CORS_ORIGIN=https://painel.seudominio.com
# DATABASE_URL=postgresql://...
# REDIS_HOST=...
# REDIS_PASSWORD=...          # obrigatorio em producao
# REDIS_TLS=true
# DOC_TOKEN=...               # openssl rand -hex 16
# REVGAS_MODE=live
# REVGAS_API_URL=...
# REVGAS_ESTABLISHMENT_ID=...
# REVGAS_API_KEY=...
# WHATSAPP_MODE=live
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_ACCESS_TOKEN=...   # token permanente de usuario do sistema (o temporario expira em 24h)
# WHATSAPP_APP_SECRET=...
# WHATSAPP_VERIFY_TOKEN=...   # openssl rand -hex 16
# RESEND_API_KEY=...          # so com auth ligado (dominio verificado: SPF/DKIM/DMARC)
# EMAIL_FROM=Nome <no-reply@seudominio.com>
