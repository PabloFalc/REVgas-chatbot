{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun add:*)",
      "Bash(bun test:*)",
      "Bash(bun run typecheck)",
      "Bash(bun run build)",
      "Bash(bun run docker:infra)",
      "Bash(bun run docker:ps)",
      "Bash(bun run docker:logs)",
      "Bash(bunx tsc:*)",
      "Bash(bunx drizzle-kit generate:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "WebFetch(domain:revgas.stoplight.io)",
      "WebFetch(domain:bun.sh)",
      "WebFetch(domain:bun.com)",
      "WebFetch(domain:hono.dev)",
      "WebFetch(domain:orm.drizzle.team)",
      "WebFetch(domain:zod.dev)",
      "WebFetch(domain:developers.facebook.com)",
      "WebFetch(domain:viacep.com.br)"
    ],
    "ask": [
      "Bash(bun run docker:reset)",
      "Bash(docker compose down:*)",
      "Bash(bunx drizzle-kit push:*)",
      "Bash(bunx drizzle-kit migrate:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Bash(npm install:*)",
      "Bash(yarn add:*)",
      "Bash(pnpm add:*)"
    ]
  }
}
